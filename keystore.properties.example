# Example keystore configuration file for Android App Signing
# Copy this file to 'keystore.properties' (which is git-ignored) and fill in your values.
# NEVER commit your real 'keystore.properties' or your keystore (*.jks) to version control!

# Relative or absolute path to your release keystore file
storeFile=release.keystore

# Master password protecting the keystore file
storePassword=your_keystore_password

# Specific alias of the signing key inside the keystore
keyAlias=todoapp_key

# Password protecting the specific key alias
keyPassword=your_key_password
